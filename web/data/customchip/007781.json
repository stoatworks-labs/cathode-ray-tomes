out","from":"board","drive":"out"},{"n":"57","name":"V2C0","dir":"out","from":"board","drive":"out"},{"n":"58","name":"VD13","dir":"in","from":"board","drive":"in"},{"n":"59","name":"VD14","dir":"in","from":"board","drive":"in"},{"n":"60","name":"VD15","dir":"in","from":"board","drive":"in"},{"n":"61","name":"VC2","dir":"in","from":"board","drive":"in"},{"n":"62","name":"VC1","dir":"in","from":"board","drive":"in"},{"n":"63","name":"VC0","dir":"in","from":"board","drive":"in"},{"n":"64","name":"VDD","dir":"power","from":"board","drive":""}],"pinCheck":[{"board":"final-round-gx870","refs":["U45"],"same":64,"overbar":[],"unnamed":0,"differ":[],"missing":[],"extra":[]},{"board":"twin-16-gx687","refs":["B_C11"],"same":64,"overbar":[],"unnamed":0,"differ":[],"missing":[],"extra":[]},{"board":"twin-16-rev-b","refs":["B_P4"],"same":64,"overbar":[],"unnamed":0,"differ":[],"missing":[],"extra":[]}],"inside":{"parts":432,"libraries":{"ga_oki_msm70v0000":432},"nets":770,"named":358,"sheets":[{"title":"Top sheet","page":1},{"title":"Pixel Counters","page":2},{"title":"Tilemap 1 Output","page":3},{"title":"Tilemap 2 Output","page":4},{"title":"Tilemap 1 Pixel Select","page":5},{"title":"Tilemap 2 Pixel Select","page":6}]},"notes":[{"kind":"silicon","text":"The Schematics have been analyzed from\na die picture by InfosecDJ.\nThe chip is identified as:\n\nMSM OKi\n79H041\n\nIt is a MSM79V000 gate array\nfrom the MSM70V000 series.\n- 3289 Basic Cells\n- 23 Columns, 143 Rows"},{"kind":"function","text":"The konami 007781 is a tilemap pixel shift register\nwith scroll. The tiles are 8x8 pixels, but the 007781\ndon't care about vertical line position. 007781 handles\ntwo tilemaps at a time:\n- V1, tilemap 1\n- V2, tilemap 2\n\n8 pixels, 4 bits each, of color data at a time are latched\ninto the registers. The palette code is latched 8 pixel\nclocks earlier from VRAM. This is because the \ndata in the 007780 DRAM controller and DRAM takes 8\npixel clocks to process.\n\nV1 latches pixels when the horizontal counter, going\nfrom 0 to 7,  goes to 2 (HCNT2) and V2 latches when\nthe horizontal counter goes to 4.\nData latched for:\n- V1, when HCNT[2:0] == 2\n- V2, when HCNT[2:0] == 4\n\nThe pixel code and palette color data are shifted\nout between 1 to 9 pixel clocks after HCNT[2:0] == 4,\ndepending on if scroll or horizontal flip are active."}],"readFrom":"a die photo by InfosecDJ","pdf":"/chips/007781.pdf","license":"GPL-3.0","origin":{"project":"jtcores","url":"https://github.com/jotego/jtcores/tree/e7b11263b04978790d4a3b9dd7e188b2dc976e4b/cores/twin16/sch/007781","commit":"e7b11263b04978790d4a3b9dd7e188b2dc976e4b","path":"cores/twin16/sch/007781","authors":["Ulf Skutnabba"],"license":"GPL-3.0","licenseUrl":"https://github.com/stoatworks-labs/cathode-ray-tomes/blob/main/kicad/chips/007781/LICENSE","source":"https://github.com/stoatworks-labs/cathode-ray-tomes/tree/main/kicad/chips/007781","imported":"2026-10-20"},"kicanvas":{"base":"https://raw.githubusercontent.com/stoatworks-labs/cathode-ray-tomes/main/kicad/chips/007781/","files":["007781.kicad_sch","pixel_counters.kicad_sch","tmap1_out.kicad_sch","tmap2_out.kicad_sch","tilemap1_px_sel.kicad_sch","tilemap2_px_sel.kicad_sch"],"bytes":1752699},"boards":[{"slug":"final-round-gx870","name":"The Final Round PCB (GX870)","mfr":"Konami","year":"1988","license":"GPL-3.0","refs":[{"ref":"U45","section":"GFX - Tiles"}],"machines":["fround"]},{"slug":"twin-16-gx687","name":"Twin 16 (GX687 / GX785)","mfr":"Konami","year":"1987","license":"GPL-3.0","refs":[{"ref":"B_C11","section":"Tile Layers"}],"machines":["devilw","vulcan"]},{"slug":"twin-16-rev-b","name":"Twin 16 rev B (GX785 / GX870 / GX808 / GX903)","mfr":"Konami","year":"1988","license":"GPL-3.0","refs":[{"ref":"B_P4","section":"Tile Layers"}],"machines":["vulcan","fround"]}],"layouts":[],"machines":[["fround","The Final Round (version M)"],["devilw","Devil World"],["vulcan","Vulcan Venture (new)"]]}