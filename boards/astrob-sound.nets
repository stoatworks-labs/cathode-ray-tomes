# line 1197: NET_C(GND, U7.5, U7.6, U7.12, U7.13) -> nc -- tied to GND in MAME's "Unconnected inputs" block
# line 1198: NET_C(GND, U26.13) -> nc -- tied to GND in MAME's "Unconnected inputs" block
