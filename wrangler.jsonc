{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cathode-ray-tomes",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Keep the workers.dev hostname live alongside the custom domain: it is a
  // useful fallback when a network's web filter blocks the (newly registered)
  // apex domain.
  "workers_dev": true,

  // Custom domain (zone cathode-ray-tomes.com is active on this account).
  "routes": [
    { "pattern": "cathode-ray-tomes.com", "custom_domain": true },
    { "pattern": "www.cathode-ray-tomes.com", "custom_domain": true }
  ],

  // Everything ships here: the UI *and* the corpus (web/data), so a deploy
  // publishes code and data together. Rebuild web/data with
  // `python3 tools/build_assets.py` before deploying.
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // Reader submissions (/api/submit) are filed into a *separate* repository so
  // that unvetted uploads never sit in the tree Workers Builds deploys. The
  // token is a secret, not a var:
  //
  //   npx wrangler secret put GITHUB_TOKEN
  //
  // A fine-grained PAT scoped to the queue repo alone, with Contents: read and
  // write and Issues: read and write. Without it /api/submit reports itself
  // disabled and the form says so rather than failing on send.
  "vars": {
    "SITE_NAME": "Cathode Ray Tomes",
    "UPSTREAM": "https://files.arcadertfm.com",
    "SUBMISSIONS_REPO": "stoatworks-labs/cathode-ray-tomes-submissions",
    "SUBMISSIONS_BRANCH": "main"
    // "TURNSTILE_SITEKEY": "0x...",   // with the TURNSTILE_SECRET secret,
    //                                 // enables the challenge on the form
  },

  // A public form that commits to a repository needs a floor under it. Keyed
  // on client IP; `period` accepts only 10 or 60. The namespace id is local to
  // this Worker and just has to stay stable.
  "unsafe": {
    "bindings": [
      {
        "name": "SUBMIT_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 5, "period": 60 }
      }
    ]
  }
}
