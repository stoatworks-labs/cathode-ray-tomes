# ---------------------------------------------------------------------------
# Supplies
# ---------------------------------------------------------------------------
net GND: C107.2 C109.2 C111.2 C113.2 C114.2 C115.2 C116.2 C118.2 C120.2 C121.2 C122.2 C207.2 C209.2 C211.2 C213.2 C214.2 C215.2 C216.2 C218.2 C220.2 C221.2 C222.2 C307.2 Q105.E Q108.E Q205.E Q208.E Q302.E R103.3 R105.2 R106.2 R110.3 R112.2 R114.2 R120.2 R123.3 R125.2 R127.2 R133.2 R203.3 R205.2 R206.2 R210.3 R212.2 R214.2 R220.2 R223.3 R225.2 R227.2 R233.2
net +16V: Q104.E Q107.E Q204.E Q207.E R107.1 R108.1 R119.1 R132.1 R207.1 R208.1 R219.1 R232.1 R302.1

# ---------------------------------------------------------------------------
# Detailed circuit model of the dual-transistor switches.
# ---------------------------------------------------------------------------
port IN_LS: R134.1  # in MAME: LOGIC_INPUT(I_LEFT_SHOT)
port IN_RS: R234.1  # in MAME: LOGIC_INPUT(I_RIGHT_SHOT)
port IN_LH: R121.1  # in MAME: LOGIC_INPUT(I_LEFT_HIT)
port IN_RH: R221.1  # in MAME: LOGIC_INPUT(I_RIGHT_HIT)
wire Q108.B R133.1 R134.2
wire Q208.B R233.1 R234.2
wire Q105.B R120.1 R121.2
wire Q205.B R220.1 R221.2
wire Q108.C R131.1
wire Q208.C R231.1
wire Q105.C R118.1
wire Q205.C R218.1

# ---------------------------------------------------------------------------
# All connected to 16-volt power.
# ---------------------------------------------------------------------------
wire Q107.B R131.2 R132.2
wire Q207.B R231.2 R232.2
wire Q104.B R118.2 R119.2
wire Q204.B R218.2 R219.2
wire Q107.C R130.1
wire Q207.C R230.1
wire Q104.C R117.1
wire Q204.C R217.1

# ---------------------------------------------------------------------------
# Current supply and storage capacitors for sound-effect
# ---------------------------------------------------------------------------
wire C122.1 R124.1 R126.1 R130.2
wire C222.1 R224.1 R226.1 R230.2
wire C116.1 R111.1 R113.1 R117.2
wire C216.1 R211.1 R213.1 R217.2

# ---------------------------------------------------------------------------
# Normally-distributed noise of 2 millivolts RMS voltage.
# ---------------------------------------------------------------------------
wire D304.2 Q302.B
wire C307.1 D304.1 R303.2
wire C303.1 C304.1 C305.1 C306.1 Q302.C R302.2 R303.1

# ---------------------------------------------------------------------------
# Sound effect frequency filters.
# ---------------------------------------------------------------------------
wire C303.2 R129.1
wire C306.2 R229.1
wire C304.2 R116.1
wire C305.2 R216.1
wire C121.1 R128.1 R129.2
wire C221.1 R228.1 R229.2
wire C115.1 R115.1 R116.2
wire C215.1 R215.1 R216.2

# ---------------------------------------------------------------------------
# Sound effect amplifier circuits.
# ---------------------------------------------------------------------------
wire C120.1 Q106.B R126.2 R127.1 R128.2
wire C220.1 Q206.B R226.2 R227.1 R228.2
wire C114.1 Q103.B R113.2 R114.1 R115.2
wire C214.1 Q203.B R213.2 R214.1 R215.2
wire Q106.E R125.1
wire Q206.E R225.1
wire C113.1 Q103.E R112.1
wire C213.1 Q203.E R212.1

# ---------------------------------------------------------------------------
# These circuits act as high-pass filters on the sound effect
# ---------------------------------------------------------------------------
wire C119.1 Q106.C R124.2
wire C219.1 Q206.C R224.2
wire C112.1 Q103.C R111.2
wire C212.1 Q203.C R211.2
wire C118.1 C119.2 R123.1
wire C218.1 C219.2 R223.1
wire C111.1 C112.2 R110.1
wire C211.1 C212.2 R210.1

# ---------------------------------------------------------------------------
# Mixing of shot and hit sounds for each side.
# ---------------------------------------------------------------------------
wire R122.2 R123.2
wire R222.2 R223.2
wire R109.2 R110.2
wire R209.2 R210.2
wire C117.2 R122.1
wire C217.2 R222.1
wire C110.2 R109.1
wire C210.2 R209.1

# ---------------------------------------------------------------------------
# Second-stage amplifier circuits, which amplify each side's
# ---------------------------------------------------------------------------
wire C110.1 C117.1 Q102.B R105.1 R107.2
wire C210.1 C217.1 Q202.B R205.1 R207.2
wire C109.1 Q102.E R106.1
wire C209.1 Q202.E R206.1

# ---------------------------------------------------------------------------
# Coupling capacitors, bandpass filters, and volume
# ---------------------------------------------------------------------------
wire C108.1 Q102.C R108.2
wire C208.1 Q202.C R208.2
wire C108.2 R104.1
wire C208.2 R204.1

# ---------------------------------------------------------------------------
# There are two master volume pots, for left and right.
# ---------------------------------------------------------------------------
wire C107.1 R103.1 R104.2
wire C207.1 R203.1 R204.2
port OUT_L: R103.2  # to the left power amplifier, which MAME does not simulate
port OUT_R: R203.2  # to the right power amplifier, which MAME does not simulate

# ---------------------------------------------------------------------------
# Pins with nothing attached
# ---------------------------------------------------------------------------
