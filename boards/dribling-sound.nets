# ---------------------------------------------------------------------------
# Gates of the sound's packages that other circuits use
# ---------------------------------------------------------------------------
port AD4Q: UL9.6  # a spare gate of the sound's L9, used by the 8255s' chip-select decoding on the same sheet, not by the sound
port AD4: UL9.5  # a spare gate of the sound's L9, used by the 8255s' chip-select decoding on the same sheet, not by the sound
port AD3Q: UL9.4  # a spare gate of the sound's L9, used by the 8255s' chip-select decoding on the same sheet, not by the sound
port AD3: UL9.3  # a spare gate of the sound's L9, used by the 8255s' chip-select decoding on the same sheet, not by the sound
port RES: UB7.2  # a spare gate of the sound's B7, used by the 8255s' reset (RES out, to pin 35 of each) on the same sheet, not by the sound
port RESETQ: UB7.1  # a spare gate of the sound's B7, used by the 8255s' reset (/RESET in) on the same sheet, not by the sound

# ---------------------------------------------------------------------------
# FINAL MIX, DISABLE CIRCUITRY AND OUTPUT FILTER
# ---------------------------------------------------------------------------
port AMP_IN: VRC.2  # VR-C's wiper, on through 10uF/16V to pin 1 of the TDA2003 power amplifier, which MAME does not simulate
label MIX: Q_OUT.C R_CALCIO_A.2 R_CALCIO_B.2 R_FISCHIO.2 R_FOLLA.2 R_PARATA.2 R_STOP_PALLA.2 R_TOS.2 VRC.1
port ENABLE_SOUND: R_OUT.1 R_PU_OUT.2  # in MAME: TTL_INPUT(ENABLE_SOUND)
wire Q_OUT.B R_OUT.2

