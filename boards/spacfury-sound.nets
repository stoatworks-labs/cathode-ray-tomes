#   line 354: CAP(C2, CAP_U(0.05))
#   line 355: CAP(C3, CAP_U(0.05))
#   line 356: CAP(C4, CAP_U(10))      -- part of final amp (not emulated)
#   line 361: CAP(C9, CAP_U(0.05))
#   line 362: CAP(C10, CAP_U(0.05))
#   line 368: CAP(C16, CAP_U(0.05))
#   line 369: CAP(C17, CAP_U(0.05))
#   line 377: CAP(C25, CAP_U(0.05))
