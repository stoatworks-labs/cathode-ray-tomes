# Pins the MAME netlist never mentions. On a real board these are unused outputs, or
# inputs left open or tied in a way MAME did not draw; they are written here so that
# the checker's coverage test still means something for every other pin.
nc UA7.3 UA7.4 UA7.5 UA7.6 UA7.10 UA7.11  # Q0 Q1 Q2 Q3 Q4 Q5
nc UA8.4 UA8.5 UA8.6 UA8.10 UA8.11 UA8.12  # Q1 Q2 Q3 Q4 Q5 Q6
nc UB8.6 UB8.8 UB8.11  # output output output
nc UB9.1 UB9.6 UB9.7 UB9.8 UB9.9 UB9.14  # open collector - + - + open collector
nc UC7.2 UC7.3 UC7.6  # ~{Q} Q ~{Q}
nc UC8.1 UC8.7 UC8.8  # output output output
nc UD7.11 UD7.12 UD7.13 UD7.14  # Q3 Q2 Q1 Q0
nc UE7.11 UE7.12 UE7.13 UE7.14  # Q3 Q2 Q1 Q0
nc UE8.6  # output
nc UL9.1 UL9.2 UL9.8 UL9.9 UL9.10 UL9.11  # input output output input output input
nc UN9.3 UN9.11  # CONT CONT
nc UQ9.3 UQ9.11  # CONT CONT
