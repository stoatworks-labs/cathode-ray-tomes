port OUT_3: U3A.5 U6C.3  # in MAME: TTL_INPUT(I_OUT_3)
port OUT_4: U3A.10  # in MAME: TTL_INPUT(I_OUT_4)
wire C14.1 U3A.1 U4A.2 R18.1
wire C14.2 U4A.6 R18.2 R19.1
