value ZD_1N5239 1N5239

# ---------------------------------------------------------------------------
# Supplies
# ---------------------------------------------------------------------------
net GND: C18.2 C2.2 C22.2 C6.2 CNOISE.2 CNOISE0.2 UG4.7 UG5.1 UG5.7 UH4.7 UH5.7 UJ3.7 UJ5.7 UJ4.7 UH2.3 R19.2 R25.2 R41.2 R6.2 RNOISE3.2
net +12V: UH2.8 R23.1 RNOISE0.1
net +5V: UG4.14 UG5.14 UH4.14 UH5.14 UJ3.14 UJ5.14 UJ4.14 R10.1 R14.1 R20.1 R22.1 R26.1 R3.1 R34.1 R39.1 R42.1 R43.1 R44.1 R45.1 R51.1 R55.1 R57.1 R61.1 R62.1 R67.1 R7.1

# ---------------------------------------------------------------------------
# 22 uF in Laguna Racer and Super Speed Race
# ---------------------------------------------------------------------------
port PEDAL_BIT0: R42.2 R46.1  # in MAME: LOGIC_INPUT(I_F5_2)
port PEDAL_BIT1: R43.2 R47.1  # in MAME: LOGIC_INPUT(I_F5_5)
port PEDAL_BIT2: R44.2 R48.1  # in MAME: LOGIC_INPUT(I_F5_7)
port PEDAL_BIT3: R45.2 R49.1  # in MAME: LOGIC_INPUT(I_F5_10)
wire UH5.13 R46.2 R47.2 R48.2 R49.2 R51.2
wire UH5.8 R50.2
wire D4.1 UH5.9 R50.1 R53.1
wire C18.1 R52.1 R53.2 R54.1 R56.2
wire D4.2 R52.2
wire UH5.12 R54.2 R55.2
wire UG5.4 UH5.11 R57.2 R58.2
wire D5.2 UH5.10 R29.1 R30.1 R31.1 R32.1 R36.1 R37.1 R59.1
wire D5.1 R58.1
wire C19.1 R59.2 R60.2
wire UG5.2 R56.1
port ENGINE_SOUND_OFF: D1.2 UG5.13 R22.2  # in MAME: LOGIC_INPUT(I_F4_5)
port HI_SHIFT: UG5.5 R62.2  # in MAME: LOGIC_INPUT(I_F5_12)
wire C19.2 UG5.3 UG5.8
wire UG5.9 R60.1
port LO_SHIFT: UG5.6 R61.2  # in MAME: LOGIC_INPUT(I_F5_15)

# ---------------------------------------------------------------------------
# With a frontier, uncompensated, this decreases to 86 Hz.
# ---------------------------------------------------------------------------
wire UJ4.10 R37.2
wire UJ5.2 UJ4.11
wire C17.1 UJ5.3 R36.2
wire C17.2 D3.2 UJ5.4 R38.1
wire UJ5.6 R38.2
wire UJ5.5 UJ4.12 R40.1
wire UJ5.1 R39.2 R40.2
wire C16.1 D2.1 D3.1 R41.1

# ---------------------------------------------------------------------------
# With a frontier, uncompensated, this decreases to 329 Hz.
# ---------------------------------------------------------------------------
wire UJ4.4 R32.2
wire UJ3.13 UJ4.3
wire C15.1 UJ3.8 R31.2
wire C15.2 D2.2 UJ3.9 R33.1
wire UJ3.11 R33.2
wire UJ3.10 UJ4.5 R35.1
wire UJ3.12 R34.2 R35.2
wire C16.2 UH2.1

# ---------------------------------------------------------------------------
# For Laguna Racer, when equipped with a 100 Kohm resistor and
# ---------------------------------------------------------------------------
wire UJ4.1 R30.2
wire UJ3.2 UJ4.2
wire C14.1 UJ3.3 R29.2
wire C13.1 C14.2 UJ3.4 R28.1
wire UJ3.6 R28.2
wire UJ3.5 UJ4.13 R27.1
wire UJ3.1 R26.2 R27.2
wire C13.2 D1.1 UH2.2 R23.2 R25.1

# ---------------------------------------------------------------------------
# Simple model of a 1N5239 9.1-volt Zener diode. The 1N5239 is
# ---------------------------------------------------------------------------
wire CNOISE0.1 RNOISE0.2 ZD_1N5239.1
wire CNOISE.1 RNOISE1.1 RNOISE2.1
wire UH4.3 RNOISE1.2
wire UH4.2 ZD_1N5239.2
wire C1.1 UH4.4 RNOISE2.2 RNOISE3.1
wire C1.2 R1.1

# ---------------------------------------------------------------------------
# The noise generator is followed by a single-amplifier active
# ---------------------------------------------------------------------------
wire C2.1 R1.2 R2.1 R4.1
wire C3.1 UH4.6 R2.2
wire UH4.1 R3.2
wire C3.2 C4.1 C5.1 UH4.5 R17.1 R4.2 R5.1

# ---------------------------------------------------------------------------
# This is a two-amplifier active bandpass filter with a center
# ---------------------------------------------------------------------------
wire C7.1 C8.1 R12.1 R5.2 R6.1
wire C7.2 UH4.8 R8.1
wire UH4.13 R7.2
wire C8.2 UH4.9 R8.2 R9.1

# ---------------------------------------------------------------------------
# R11.)
# ---------------------------------------------------------------------------
wire UH4.11 R11.1 R9.2
wire UH4.12 R10.2
wire UG4.4 UH4.10 R11.2 R12.2
wire UG4.3 R63.1
port NOISE_CR_1: UG4.5  # in MAME: LOGIC_INPUT(I_F4_7)

# ---------------------------------------------------------------------------
# Second noise circuit: post-crash noise (NOISE_CR_2)
# ---------------------------------------------------------------------------
wire C4.2 R16.1
wire C6.1 R13.1 R15.1 R16.2
wire C9.1 UH5.3 R15.2
wire UH5.2 R14.2
wire C9.2 UG4.8 UH5.4 R13.2
wire UG4.9 R64.1
port NOISE_CR_2: UG4.6  # in MAME: LOGIC_INPUT(I_F4_10)

# ---------------------------------------------------------------------------
# Resistor R18, part of the BOOM filter, is 2.2 Kohms on the
# ---------------------------------------------------------------------------
wire C5.2 UG4.1 R17.2
wire UG4.2 R18.1
port BOOM: UG4.13  # in MAME: LOGIC_INPUT(I_F4_2)
wire C10.1 C11.1 R18.2 R19.1
wire C10.2 UH5.6 R21.1
wire UH5.1 R20.2
wire C11.2 UH5.5 R21.2 R65.1

# ---------------------------------------------------------------------------
# The preamplification stage after the final mix has two LM3900
# ---------------------------------------------------------------------------
wire C20.1 R63.2 R64.2 R65.2
wire UH2.7 R66.1
wire C21.1 R66.2
wire C22.1 R67.2 R68.1 R74.1
wire UJ5.13 R68.2
wire UJ5.12 R74.2
wire C23.2 R70.2
wire C20.2 C21.2 UJ5.8 R69.1 R70.1
wire C23.1 C24.1 UJ5.9 R69.2
wire C24.2 R73.1
wire UJ5.11 R73.2 R75.1
port OUTPUT: UJ5.10 R75.2  # to the audio power amplifier, which MAME does not simulate

# ---------------------------------------------------------------------------
# Pins with nothing attached
# ---------------------------------------------------------------------------
nc UG5.10 UG5.11 UG5.12 UJ4.6 UJ4.8 UJ4.9 UG4.10 UG4.11 UG4.12  # line 1040: tied to GND in MAME's "Switches G5_D, J4_C, and G4_D are unused." block
# Pins the MAME netlist never mentions. On a real board these are unused outputs, or
# inputs left open or tied in a way MAME did not draw; they are written here so that
# the checker's coverage test still means something for every other pin.
nc UH2.4 UH2.5 UH2.6  # NC NC ROLLOFF
