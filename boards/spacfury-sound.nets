#   line 428: CAP(C77, CAP_U(0.1))
#   line 429: CAP(C78, CAP_U(0.1))
#   line 430: CAP(C79, CAP_U(0.1))
#   line 431: CAP(C80, CAP_U(0.1))
#   line 450: Q_2N4093(Q1)        -- part of final amp (not emulated)
#   line 464: TL082_DIP(U1)           // Op. Amp. -- part of final amp (not emulated)
#   line 564: TTL_74LS08_DIP(U25)     // Quad 2-Input AND Gates
#   line 572: TTL_74LS10_DIP(U28)     // Triple 3-Input NAND Gate
#   line 576: TTL_74LS14_DIP(U30)
#   line 584: TTL_74LS374_DIP(U32)    // Octal D-Type Transparent Latches And Edge-Triggered Flip-Fl
#   line 588: TTL_74LS374_DIP(U33)    // Octal D-Type Transparent Latches And Edge-Triggered Flip-Fl
#   line 592: TTL_74LS30_DIP(U34)     // 8-Input NAND Gate
#   line 596: TTL_74LS14_DIP(U35)
#
# The oscillators MAME runs as ideal clocks (CLOCK) are ports, and the timing parts it
# parks on a rail in their place are listed above; SPLIT_SHARED_OSCILLATORS is off, so
# each oscillator drives everything the board has it drive. The site holds no Space Fury
# manual, so there is no sheet here to compare this with.
#
# Not compared with the sheet. MAME's designators, values and pin numbers are taken as
# MAME has them; the checker shows the netlist is internally consistent (every pin exists,
# no two outputs fight, nothing floats), which is not the same as matching the board.

