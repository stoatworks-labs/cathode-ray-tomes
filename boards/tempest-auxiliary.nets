sig UE4.6 A6A3
sig UE4.8 CPU8
sig UE5.8 45A1
sig UE5.11 C646
sig UD4.6 C4U4
sig UD4.8 0600
sig UF5.11 C835
# 753F: the 2nd printing reads C53F (its first stroke runs into R42's lead)
sig UF5.6 753F
sig UE4.11 CC34
# Slices, printed under their pin columns (8, 16 starred)
sig UE2.16 9AFH
sig UE2.31 1781
sig UE2.34 A1F7
sig UJ2.8 7U19
sig UJ2.16 11C5
# 8631: the 2nd printing reads 8638
sig UJ2.33 8631
sig UF/H2.8 78AA
sig UF/H2.16 11C5
sig UF/H2.33 9CPP
sig UK/L2.8 809A
sig UK/L2.16 9AFH
sig UK/L2.33 6PUP
# Program counter outputs: left column (Test #1) beside the address lines; right
# column in the box printed "TEST #2" (rows 15 1 2 3 4 7 6 5 = MA7 ... MA0)
sig UC1.11 H58A
sig UC1.12 77F7
sig UC1.13 85PA
sig UC1.14 7P25
sig UD1.11 5CP0
sig UD1.12 P5PH
