# Rip Off sound board -- netlist converted from MAME
#
# Cinematronics vector games carry a small audio board of their own, driven from the
# CPU board's output latch: the latch bits arrive here as ports (OUT_0 ... OUT_7, MAME's
# TTL_INPUT names), and the board's sound goes out to a final amplifier that MAME does
# not simulate and this file therefore does not contain.
#
# Source: MAME mame0289 (commit f34f02505e32), src/mame/cinematronics/nl_ripoff.cpp,
# NETLIST_START(ripoff). Licence CC0-1.0 by the file's own header (line 1),
# copyright-holders Aaron Giles (line 2).
# https://raw.githubusercontent.com/mamedev/mame/mame0289/src/mame/cinematronics/nl_ripoff.cpp
# Converted by tools/mame_netlist.py; checked by tools/build_board_nets.py.
#
# What the conversion means. MAME's netlists are written to be simulated, so this is a
# second reading of the sheet by someone else, not a read of it: designators and pin
# numbers are MAME's unless the notes say the sheet was read to correct them. Names on
# `label` lines are MAME's, which mostly follow the sheet's with Q for an overbar; `net`
# is used only for the supply rails. A `port` is a net that leaves what this file
# describes -- a signal from the CPU or the other board, a cabinet control, or a source
# MAME simulates with a stand-in rather than the circuit.
#
#   net NAME: PIN ...     a supply rail
#   label NAME: PIN ...   a net MAME names
#   wire PIN PIN ...      an unnamed connection
#   port NAME: PIN ...    a net that leaves this file (see above)
#   nc PIN ...            a pin with nothing attached
#   parallel PIN ...      outputs the board sums on one node by design
#   value REF VALUE       a passive's value, in the unit MAME's own macro uses
#
# PIN is DESIGNATOR.NUMBER. Diode pin 1 is the cathode; transistors keep B, C and E;
# MAME does not record which way round an electrolytic goes, so C pins are MAME's 1/2.
# The sheet numbers its ICs IC1, IC2 ...; they are written U1, U2 ... here, because the
# checker files every IC under a U designator.
#
# ---------------------------------------------------------------------------
# Undone: what MAME does to simulate the board that the board does not do
# ---------------------------------------------------------------------------
# line 30: #define HLE_LASER_VCO 1 -> 0 (high-level stand-in for a real circuit)
# line 31: #define HLE_TORPEDO_VCO 1 -> 0 (high-level stand-in for a real circuit)
# line 32: #define HLE_BACKGROUND_VCOS 1 -> 0 (high-level stand-in for a real circuit)
# line 33: #define ENABLE_FRONTIERS 1 -> 0 (solver partitioning only)
# line 40: #define HACK_VOLTAGE_SWITCH 1 -> 0 (simulation hack)
# line 41: #define HACK_CCA_RESISTANCE 1 -> 0 (simulation hack)
# line 678: NET_C(GND, IC9.17, IC9.18, IC10.9, IC22.12, IC22.13) -> nc -- tied to GND in MAME's "Unconnected inputs" block
# line 679: NET_C(GND, IC14.2, IC14.3, IC15.2, IC15.3) -> nc -- tied to GND in MAME's "Unconnected inputs" block
# Stand-ins that are not parts (the nets they drive are ports): TTL_INPUT(I_OUT_0), TTL_INPUT(I_OUT_1), TTL_INPUT(I_OUT_2), TTL_INPUT(I_OUT_3), TTL_INPUT(I_OUT_4), TTL_INPUT(I_OUT_7)
#
# Left out by MAME (commented out at TAG, so not in this file either):
#   line 132: RES(R46, RES_K(12))  -- part of final amp (not emulated)
#   line 136: POT(R50, RES_K())    -- listed as optional on schematics
#   line 137: RES(R51, RES_K(1.5)) -- part of final amp (not emulated)
#   line 138: RES(R52, 150)        -- part of final amp (not emulated)
#   line 139: RES(R53, RES_K(22))  -- part of final amp (not emulated)
#   line 140: RES(R54, 150)        -- part of final amp (not emulated)
#   line 141: RES(R55, RES_K(39))  -- part of final amp (not emulated)
#   line 191: CAP(C13, CAP_U())      -- not used according to schematics
#   line 198: CAP(C20, CAP_U())      -- not used according to schematics
#   line 200: CAP(C22, CAP_U(0.005)) -- part of final amp (not emulated)
#   line 201: CAP(C23, CAP_P(470))   -- part of final amp (not emulated)
#   line 202: CAP(C24, CAP_P(470))   -- part of final amp (not emulated)
#   line 203: CAP(C25, CAP_P(470))   -- part of final amp (not emulated)
#   line 211: CAP(C33, CAP_U(0.1))   -- part of voltage converter (not emulated)
#   line 212: CAP(C34, CAP_U(25))    -- part of voltage converter (not emulated)
#   line 213: CAP(C35, CAP_U(25))    -- part of voltage converter (not emulated)
#   line 214: CAP(C36, CAP_U())      -- part of voltage converter (not emulated)
#   line 215: CAP(C37, CAP_U(0.1))   -- part of voltage converter (not emulated)
#   line 216: CAP(C38, CAP_U(25))    -- part of voltage converter (not emulated)
#   line 217: CAP(C39, CAP_U(25))    -- part of voltage converter (not emulated)
#   line 218: CAP(C40, CAP_U())      -- part of voltage converter (not emulated)
#   line 219: CAP(C41, CAP_U(25))    -- part of voltage converter (not emulated)
#   line 220: CAP(C42, CAP_U(0.1))   -- part of voltage converter (not emulated)
#   line 241: Q_2N6292(Q6)            // PNP -- part of final amp (not emulated)
#   line 242: Q_2N6107(Q7)            // PNP -- part of final amp (not emulated)
#   line 331: TTL_7915_DIP(IC23)      // -15V Regulator -- not emulated
#   line 332: TTL_7815_DIP(IC24)      // +15V Regulator -- not emulated
#
# MAME's two hacks here are value changes and both are undone by their switches: the
# motor-1 and beep voltage triggers use the sheet's 4.7K (MAME's hack is 100 ohms), and
# the resistances into the CA3080s IC12 and IC6 are the sheet's, not five times them.
#
# Not compared with the sheet. MAME's designators, values and pin numbers are taken as
# MAME has them; the checker shows the netlist is internally consistent (every pin exists,
# no two outputs fight, nothing floats), which is not the same as matching the board.

