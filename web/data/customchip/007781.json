{"slug":"007781","name":"Konami 007781","maker":"Konami","markings":["007781"],"summary":"The tilemap pixel shifter. For each of the two tilemaps it latches eight four-bit pixels at a time, with the palette code fetched eight pixel clocks earlier, and shifts them out with fine horizontal scroll and flip applied.","conflicts":[],"role":"Konami custom pixel shift register and multiplexer","package":{"pins":64,"symbol":"ga_konami:007781_internal"},"pins":[{"n":"1","name":"V1C6","dir":"out","from":"board","drive":"out"},{"n":"2","name":"V1C5","dir":"out","from":"board","drive":"out"},{"n":"3","name":"VC31","dir":"in","from":"board","drive":"in"},{"n":"4","name":"VC30","dir":"in","from":"board","drive":"in"},{"n":"5","name":"VC29","dir":"in","from":"board","drive":"in"},{"n":"6","name":"VC28","dir":"in","from":"board","drive":"in"},{"n":"7","name":"VC27","dir":"in","from":"board","drive":"in"},{"n":"8","name":"VC26","dir":"in","from":"board","drive":"in"},{"n":"9","name":"VC25","dir":"in","from":"board","drive":"in"},{"n":"10","name":"VC24","dir":"in","from":"board","drive":"in"},{"n":"11","name":"VC23","dir":"in","from":"board","drive":"in"},{"n":"12","name":"VC22","dir":"in","from":"board","drive":"in"},{"n":"13","name":"VC21","dir":"in","from":"board","drive":"in"},{"n":"14","name":"VC20","dir":"in","from":"board","drive":"in"},{"n":"15","name":"VC19","dir":"in","from":"board","drive":"in"},{"n":"16","name":"VSS","dir":"power","from":"board","drive":""},{"n":"17","name":"VC18","dir":"in","from":"board","drive":"in"},{"n":"18","name":"VC17","dir":"in","from":"board","drive":"in"},{"n":"19","name":"VC16","dir":"in","from":"board","drive":"in"},{"n":"20","name":"VC15","dir":"in","from":"board","drive":"in"},{"n":"21","name":"VC14","dir":"in","from":"board","drive":"in"},{"n":"22","name":"VC13","dir":"in","from":"board","drive":"in"},{"n":"23","name":"VC12","dir":"in","from":"board","drive":"in"},{"n":"24","name":"VC11","dir":"in","from":"board","drive":"in"},{"n":"25","n