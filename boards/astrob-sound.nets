#   line 483: Q_2N4093(Q4)  // avoid singular matrix being created
#   line 612: TTL_74LS374_DIP(U32)    // Octal D-Type Transparent Latches And Edge-Triggered Flip-Fl
#   line 616: TTL_74LS374_DIP(U33)    // Octal D-Type Transparent Latches And Edge-Triggered Flip-Fl
