{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cathode-ray-tomes",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Keep the workers.dev hostname live alongside the custom domain: it is a
  // useful fallback when a network's web filter blocks the (newly registered)
  // apex domain.
  "workers_dev": true,

  // Custom domain (zone cathode-ray-tomes.com is active on this account).
  "routes": [
    { "pattern": "cathode-ray-tomes.com", "custom_domain": true },
    { "pattern": "www.cathode-ray-tomes.com", "custom_domain": true }
  ],

  // Everything ships here: the UI *and* the corpus (web/data), so a deploy
  // publishes code and data together. Rebuild web/data with
  // `python3 tools/build_assets.py` before deploying.
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "vars": {
    "SITE_NAME": "Cathode Ray Tomes",
    "UPSTREAM": "https://files.arcadertfm.com"
  }
}
