{"sources":{"gm1986":{"title":"JAMMA standard (\u30d3\u30c7\u30aa\u30b2\u30fc\u30e0\u6a5f\u57fa\u677f\u306e\u898f\u683c), Table 1, as published in Game Machine no. 275, 1 January 1986, pp. 16-17","url":"https://archive.org/details/game-machine-magazine-19860101p","licence":"Magazine scan on archive.org; linked, not hosted. Pin assignments are facts, read by hand.","note":"Enacted 26 November 1985, in force 1 January 1986. The primary source: a 56-contact edge (28 a side) at 3.96 mm, switch inputs normally open and closed to GND, coin counter and lockout drivers able to work at 5 V and 12 V, and pins 9 and K tied to GND on a board with no lockout driver."},"jamma-docs":{"title":"luckyseoul/jamma-docs, standard/pinout.md and standard/variants.md (commit 9234c31b)","url":"https://github.com/luckyseoul/jamma-docs/tree/9234c31b3a3dece85bffad5f0b1f751e1c308fe4/standard","licence":"CC0 1.0 (the repository's own text)","note":"A compiled community table; its own sources are secondary. variants.md transcribes the CAPCOM-H2 kick sheet."},"capcom-h2":{"title":"CAPCOM-H2 kick harness sheet (Mike's Arcade part number), CPS-2 / CPS-III","url":"https://github.com/luckyseoul/jamma-docs/blob/9234c31b3a3dece85bffad5f0b1f751e1c308fe4/files/manuals/capcom/CAPCOM-H2.pdf","licence":"Third-party sheet; linked, not hosted. Read through the CC0 transcription in jamma-docs variants.md."},"jvs-spec":{"title":"JAMMA Video Standard (JVS), third edition, 2000-05-31 (Japanese), and the daifukkat English translation","url":"https://github.com/luckyseoul/jamma-docs/tree/9234c31b3a3dece85bffad5f0b1f751e1c308fe4/files/jvs","licence":"JAMMA's document; linked, not hosted. It defines the serial protocol, not the I/O boards' connectors."},"neogeodev":{"title":"NeoGeoDev wiki, JAMMA connector pinout (JAMMA and MVS tables)","url":"https://wiki.neogeodev.org/index.php?title=JAMMA_connector_pinout","licence":"Public Domain (the wiki's stated licence)"},"arcade-docs":{"title":"shiz/arcade-docs, konami/io/e33-jamma-wiring.md (Dancing Stage Fusion cabinet, measured)","url":"https://codeberg.org/shiz/arcade-docs/src/commit/994664efe21c1a167b4b51d30c0df3e644dfdfd6/konami/io/e33-jamma-wiring.md","licence":"WTFPL"},"mame-cps2":{"title":"MAME 0.289 capcom/cps2.cpp, connector pinouts","url":"https://github.com/mamedev/mame/blob/mame0289/src/mame/capcom/cps2.cpp#L148-L208","licence":"BSD-3-Clause"},"mame-cps3":{"title":"MAME 0.289 capcom/cps3.cpp, connector pinouts","url":"https://github.com/mamedev/mame/blob/mame0289/src/mame/capcom/cps3.cpp#L353-L386","licence":"BSD-3-Clause"},"mame-kenseim":{"title":"MAME 0.289 capcom/kenseim.cpp, \"Jamma (on CPS board)\" \u2014 the CPS-1 edge","url":"https://github.com/mamedev/mame/blob/mame0289/src/mame/capcom/kenseim.cpp#L66-L98","licence":"BSD-3-Clause"},"mame-neogeo":{"title":"MAME 0.289 snk/neogeo.cpp, MVS and JAMMA edge tables","url":"https://github.com/mamedev/mame/blob/mame0289/src/mame/snk/neogeo.cpp#L458-L494","licence":"BSD-3-Clause"},"mame-naomi":{"title":"MAME 0.289 sega/naomi.cpp, Sega I/O board notes","url":"https://github.com/mamedev/mame/blob/mame0289/src/mame/sega/naomi.cpp#L817-L1130","licence":"LGPL-2.1+"},"kicker-manual":{"title":"Kicker Conversion Kit Instruction Manual (Konami), p. 6 \"KICKER: WIRING HARNESS\" \u2014 in this collection","url":"/doc/30dc1053e750#p8","licence":"Konami's manual, read from the scan; the PDF is linked to its source archive, not hosted"},"mame-shaolins":{"title":"MAME 0.289 konami/shaolins.cpp, 18-way edge connector pinout","url":"https://github.com/mamedev/mame/blob/mame0289/src/mame/konami/shaolins.cpp#L72-L98","licence":"BSD-3-Clause"}},"connectors":{"jamma":{"name":"JAMMA 56-way edge","short":"JAMMA","layout":"edge","sides":["Solder side","Parts side"],"pitch":"3.96 mm (0.156 in)","rows":[[{"p":"A","s":"gnd","n":"GND"},{"p":"1","s":"gnd","n":"GND"}],[{"p":"B","s":"gnd","n":"GND"},{"p":"2","s":"gnd","n":"GND"}],[{"p":"C","s":"+5v","n":"+5V"},{"p":"3","s":"+5v","n":"+5V"}],[{"p":"D","s":"+5v","n":"+5V"},{"p":"4","s":"+5v","n":"+5V"}],[{"p":"E","s":"-5v","n":"-5V"},{"p":"5","s":"-5v","n":"-5V"}],[{"p":"F","s":"+12v","n":"+12V"},{"p":"6","s":"+12v","n":"+12V"}],[{"p":"H","s":"key","n":"Key"},{"p":"7","s":"key","n":"Key"}],[{"p":"J","s":"counter2","n":"Coin counter 2"},{"p":"8","s":"counter1","n":"Coin counter 1"}],[{"p":"K","s":"lockout2","n":"Coin lockout 2"},{"p":"9","s":"lockout1","n":"Coin lockout 1"}],[{"p":"L","s":"spk-","n":"Speaker (-)"},{"p":"10","s":"spk+","n":"Speaker (+)"}],[{"p":"M","s":"audio.gnd","n":"Audio (GND)"},{"p":"11","s":"audio+","n":"Audio (+)"}],[{"p":"N","s":"video.g","n":"Video green"},{"p":"12","s":"video.r","n":"Video red"}],[{"p":"P","s":"video.sync","n":"Video sync"},{"p":"13","s":"video.b","n":"Video blue"}],[{"p":"R","s":"service","n":"Service switch"},{"p":"14","s":"video.gnd","n":"Video GND"}],[{"p":"S","s":"tilt","n":"Tilt switch"},{"p":"15","s":"test","n":"Test switch"}],[{"p":"T","s":"coin2","n":"Coin switch 2"},{"p":"16","s":"coin1","n":"Coin switch 1"}],[{"p":"U","s":"p2.start","n":"Start switch 2"},{"p":"17","s":"p1.start","n":"Start switch 1"}],[{"p":"V","s":"p2.up","n":"2P up"},{"p":"18","s":"p1.up","n":"1P up"}],[{"p":"W","s":"p2.down","n":"2P down"},{"p":"19","s":"p1.down","n":"1P down"}],[{"p":"X","s":"p2.left","n":"2P left"},{"p":"20","s":"p1.left","n":"1P left"}],[{"p":"Y","s":"p2.right","n":"2P right"},{"p":"21","s":"p1.right","n":"1P right"}],[{"p":"Z","s":"p2.b1","n":"2P push 1"},{"p":"22","s":"p1.b1","n":"1P push 1"}],[{"p":"a","s":"p2.b2","n":"2P push 2"},{"p":"23","s":"p1.b2","n":"1P push 2"}],[{"p":"b","s":"p2.b3","n":"2P push 3"},{"p":"24","s":"p1.b3","n":"1P push 3"}],[{"p":"c","s":"spare","n":"2P spare input (control 8)"},{"p":"25","s":"spare","n":"1P spare input (control 8)"}],[{"p":"d","s":"spare","n":"2P spare input (control 9)"},{"p":"26","s":"spare","n":"1P spare input (control 9)"}],[{"p":"e","s":"gnd","n":"GND"},{"p":"27","s":"gnd","n":"GND"}],[{"p":"f","s":"gnd","n":"GND"},{"p":"28","s":"gnd","n":"GND"}]],"sources":["gm1986","jamma-docs"],"checked":"Against eleven JAMMA pin tables in MAME 0.289's driver comments (Gaelco, Unico, ICE, IGS, Seta, BMC, Capcom CPS-1, CPS-2 and CPS-3, SNK, and a bootleg's manual in sfkick.cpp) and a Dancing Stage Fusion cabinet measured in arcade-docs: on 50 of the 56 pins no table names a different standard signal. The six that differ are 11 and M (below) and R, 14, S and 15, which the sfkick bootleg uses for joystick directions. tools/check_wiring.py.","notes":["Labels are the 1986 standard's own, translated. The standard names three buttons a player (push 1-3) and leaves pins 25/c and 26/d as spare inputs; later boards put a fourth and fifth button there, but nothing in the standard says which.","The standard gives a priority order \u2014 coin switch 1, coin counter 1 and coin lockout 1 are used before the 2s \u2014 and requires switches that are normally open and close to GND.","G, I, O and Q are not used as pin letters."],"conflicts":[{"pins":["11","M"],"text":"The 1986 standard defines 11 as audio (+) and M as audio (GND), an audio output beside the speaker pair. jamma-docs and nine of the eleven MAME tables leave both unconnected; the Neo-Geo puts audio GND on M, and ICE's Lethal Justice puts its right speaker on 11/M. Not placed for a game."},{"pins":["25","c","26","d","27","e"],"text":"jamma-docs lists buttons 4-6 on 25/c, 26/d and 27/e. The 1986 standard has 25/c and 26/d as spare inputs and 27/e as GND, and every MAME table agrees that 27/e is GND. A button wired to 27/e on a board that grounds it is a short, so buttons beyond the third are never placed on this edge."}]},"cps1-jamma":{"name":"Capcom CPS-1 JAMMA edge","short":"JAMMA","layout":"edge","sides":["Solder side","Parts side"],"pitch":"3.96 mm (0.156 in)","rows":[[{"p":"A","s":"gnd","n":"Ground"},{"p":"1","s":"gnd","n":"Ground"}],[{"p":"B","s":"gnd","n":"Ground"},{"p":"2","s":"gnd","n":"Ground"}],[{"p":"C","s":"+5v","n":"+5VDC"},{"p":"3","s":"+5v","n":"+5VDC"}],[{"p":"D","s":"+5v","n":"+5VDC"},{"p":"4","s":"+5v","n":"+5VDC"}],[{"p":"E","s":"-5v","n":"-5VDC"},{"p":"5","s":"-5v","n":"-5VDC"}],[{"p":"F","s":"+12v","n":"+12VDC"},{"p":"6","s":"+12v","n":"+12VDC"}],[{"p":"H","s":"key","n":"Key slot"},{"p":"7","s":"key","n":"Key slot"}],[{"p":"J","s":"counter2","n":"Coin counter 2"},{"p":"8","s":"counter1","n":"Coin counter 1"}],[{"p":"K","s":"lockout2","n":"Coin lock 2"},{"p":"9","s":"lockout1","n":"Coin lock 1"}],[{"p":"L","s":"spk-","n":"Speaker -"},{"p":"10","s":"spk+","n":"Speaker +"}],[{"p":"M","s":"nc","n":"N/C"},{"p":"11","s":"nc","n":"N/C"}],[{"p":"N","s":"video.g","n":"Video green"},{"p":"12","s":"video.r","n":"Video red"}],[{"p":"P","s":"video.sync","n":"Video sync"},{"p":"13","s":"video.b","n":"Video blue"}],[{"p":"R","s":"service","n":"Service switch"},{"p":"14","s":"video.gnd","n":"Video ground"}],[{"p":"S","s":"tilt","n":"Tilt switch"},{"p":"15","s":"test","n":"Test switch"}],[{"p":"T","s":"coin2","n":"Coin 2"},{"p":"16","s":"coin1","n":"Coin 1"}],[{"p":"U","s":"p2.start","n":"P2 start"},{"p":"17","s":"p1.start","n":"P1 start"}],[{"p":"V","s":"p2.up","n":"P2 up"},{"p":"18","s":"p1.up","n":"P1 up"}],[{"p":"W","s":"p2.down","n":"P2 down"},{"p":"19","s":"p1.down","n":"P1 down"}],[{"p":"X","s":"p2.left","n":"P2 left"},{"p":"20","s":"p1.left","n":"P1 left"}],[{"p":"Y","s":"p2.right","n":"P2 right"},{"p":"21","s":"p1.right","n":"P1 right"}],[{"p":"Z","s":"p2.b1","n":"P2 B1"},{"p":"22","s":"p1.b1","n":"P1 B1"}],[{"p":"a","s":"p2.b2","n":"P2 B2"},{"p":"23","s":"p1.b2","n":"P1 B2"}],[{"p":"b","s":"p2.b3","n":"P2 B3"},{"p":"24","s":"p1.b3","n":"P1 B3"}],[{"p":"c","s":"nc","n":"N/C"},{"p":"25","s":"nc","n":"N/C"}],[{"p":"d","s":"nc","n":"N/C"},{"p":"26","s":"nc","n":"N/C"}],[{"p":"e","s":"gnd","n":"Ground"},{"p":"27","s":"gnd","n":"Ground"}],[{"p":"f","s":"gnd","n":"Ground"},{"p":"28","s":"gnd","n":"Ground"}]],"sources":["mame-kenseim","gm1986"],"notes":["MAME has no pin table in cps1.cpp. Ken Sei Mogura is a CPS-1 board driving a mole cabinet, and kenseim.cpp draws the CPS-1 edge with its standard labels beside the unusual uses that game puts them to; the standard labels are the ones here.","Street Fighter II and its updates take kick buttons 4-6 from a separate connector on the board. No open source we could check gives its pin map, so it is not drawn and those buttons are listed as not placed."],"conflicts":[{"pins":["P"],"text":"kenseim.cpp letters the sync pin O. JAMMA skips O, and the row sits between N and R, so it is P."}]},"cps2-jamma":{"name":"Capcom CPS-2 JAMMA edge","short":"JAMMA","layout":"edge","sides":["Solder side","Parts side"],"pitch":"3.96 mm (0.156 in)","rows":[[{"p":"A","s":"gnd","n":"GND"},{"p":"1","s":"gnd","n":"GND"}],[{"p":"B","s":"gnd","n":"GND"},{"p":"2","s":"gnd","n":"GND"}],[{"p":"C","s":"+5v","n":"+5V"},{"p":"3","s":"+5v","n":"+5V"}],[{"p":"D","s":"+5v","n":"+5V"},{"p":"4","s":"+5v","n":"+5V"}],[{"p":"E","s":"nc","n":"NC"},{"p":"5","s":"nc","n":"NC"}],[{"p":"F","s":"+12v","n":"+12V"},{"p":"6","s":"+12v","n":"+12V"}],[{"p":"H","s":"key","n":"Key"},{"p":"7","s":"key","n":"Key"}],[{"p":"J","s":"nc","n":"NC"},{"p":"8","s":"counter1","n":"Coin counter 1"}],[{"p":"K","s":"lockout2","n":"Coin lockout"},{"p":"9","s":"lockout1","n":"Coin lockout"}],[{"p":"L","s":"spk-","n":"Speaker (-)"},{"p":"10","s":"spk+","n":"Speaker (+)"}],[{"p":"M","s":"nc","n":"NC"},{"p":"11","s":"nc","n":"NC"}],[{"p":"N","s":"video.g","n":"Video green"},{"p":"12","s":"video.r","n":"Video red"}],[{"p":"P","s":"video.sync","n":"Video composite sync"},{"p":"13","s":"video.b","n":"Video blue"}],[{"p":"R","s":"service","n":"Service switch"},{"p":"14","s":"video.gnd","n":"Video ground"}],[{"p":"S","s":"nc","n":"NC"},{"p":"15","s":"test","n":"Test"}],[{"p":"T","s":"coin2","n":"Coin B"},{"p":"16","s":"coin1","n":"Coin A"}],[{"p":"U","s":"p2.start","n":"Player 2 start"},{"p":"17","s":"p1.start","n":"Player 1 start"}],[{"p":"V","s":"p2.up","n":"Player 2 up"},{"p":"18","s":"p1.up","n":"Player 1 up"}],[{"p":"W","s":"p2.down","n":"Player 2 down"},{"p":"19","s":"p1.down","n":"Player 1 down"}],[{"p":"X","s":"p2.left","n":"Player 2 left"},{"p":"20","s":"p1.left","n":"Player 1 left"}],[{"p":"Y","s":"p2.right","n":"Player 2 right"},{"p":"21","s":"p1.right","n":"Player 1 right"}],[{"p":"Z","s":"p2.b1","n":"Player 2 button 1"},{"p":"22","s":"p1.b1","n":"Player 1 button 1"}],[{"p":"a","s":"p2.b2","n":"Player 2 button 2"},{"p":"23","s":"p1.b2","n":"Player 1 button 2"}],[{"p":"b","s":"p2.b3","n":"Player 2 button 3"},{"p":"24","s":"p1.b3","n":"Player 1 button 3"}],[{"p":"c","s":"p2.b4","n":"Player 2 button 4","alt":true},{"p":"25","s":"p1.b4","n":"Player 1 button 4","alt":true}],[{"p":"d","s":"nc","n":"NC"},{"p":"26","s":"nc","n":"NC"}],[{"p":"e","s":"gnd","n":"GND"},{"p":"27","s":"gnd","n":"GND"}],[{"p":"f","s":"gnd","n":"GND"},{"p":"28","s":"gnd","n":"GND"}]],"sources":["mame-cps2"],"notes":["cps2.cpp: only some games use button 4 on the JAMMA edge; most that need it take it from CN5. Both places are shown and marked.","The A-board carries no -5V, coin counter 2 or tilt input on the edge."],"conflicts":[]},"cps2-cn5-fight":{"name":"CPS-2 CN5 extra button connector, fighting-game wiring","short":"CN5","layout":"header","sides":["Top (odd)","Bottom (even)"],"pitch":"34-way","rows":[[{"p":"1","s":"gnd","n":"GND"},{"p":"2","s":"gnd","n":"GND"}],[{"p":"3","s":"+5v","n":"+5V"},{"p":"4","s":"+5v","n":"+5V"}],[{"p":"5","s":"+12v","n":"+12V"},{"p":"6","s":"+12v","n":"+12V"}],[{"p":"7","s":"nc","n":"NC"},{"p":"8","s":"nc","n":"NC"}],[{"p":"9","s":"p2.b6","n":"2Up button 6"},{"p":"10","s":"nc","n":"NC"}],[{"p":"11","s":"nc","n":"NC"},{"p":"12","s":"nc","n":"NC"}],[{"p":"13","s":"nc","n":"NC"},{"p":"14","s":"nc","n":"NC"}],[{"p":"15","s":"p1.b6","n":"1Up button 6"},{"p":"16","s":"nc","n":"NC"}],[{"p":"17","s":"p1.b5","n":"1Up button 5"},{"p":"18","s":"nc","n":"NC"}],[{"p":"19","s":"p1.b4","n":"1Up button 4"},{"p":"20","s":"nc","n":"NC"}],[{"p":"21","s":"p2.b4","n":"2Up button 4"},{"p":"22","s":"nc","n":"NC"}],[{"p":"23","s":"p2.b5","n":"2Up button 5"},{"p":"24","s":"nc","n":"NC"}],[{"p":"25","s":"nc","n":"NC"},{"p":"26","s":"nc","n":"NC"}],[{"p":"27","s":"nc","n":"NC"},{"p":"28","s":"nc","n":"NC"}],[{"p":"29","s":"vol.down","n":"Volume down"},{"p":"30","s":"vol.up","n":"Volume up"}],[{"p":"31","s":"gnd","n":"GND"},{"p":"32","s":"gnd","n":"GND"}],[{"p":"33","s":"gnd","n":"GND"},{"p":"34","s":"gnd","n":"GND"}]],"sources":["mame-cps2","capcom-h2"],"notes":["cps2.cpp: pins 7 to 29 can be configured to anything a game needs; this is the wiring most fighting games use. A 34-pin Hirose DF1B housing (jamma-docs).","The CAPCOM-H2 sheet agrees with cps2.cpp on every kick pin: 9, 15, 17, 19, 21 and 23. Its two kick commons (33, 34) and volume common (31) are GND here."],"conflicts":[{"pins":["29","30"],"text":"cps2.cpp has 29 volume down and 30 volume up; the CAPCOM-H2 sheet, as jamma-docs transcribes it, has them the other way round. Drawn as cps2.cpp. Check with a meter before relying on either."}]},"cps2-cn5-4p":{"name":"CPS-2 CN5 extra button connector, 3-4 player wiring","short":"CN5","layout":"header","sides":["Top (odd)","Bottom (even)"],"pitch":"34-way","rows":[[{"p":"1","s":"gnd","n":"GND"},{"p":"2","s":"gnd","n":"GND"}],[{"p":"3","s":"+5v","n":"+5V"},{"p":"4","s":"+5v","n":"+5V"}],[{"p":"5","s":"+12v","n":"+12V"},{"p":"6","s":"+12v","n":"+12V"}],[{"p":"7","s":"lockout3","n":"3Up coin lock"},{"p":"8","s":"lockout4","n":"4Up coin lock"}],[{"p":"9","s":"coin3","n":"3Up coin"},{"p":"10","s":"coin4","n":"4Up coin"}],[{"p":"11","s":"p3.start","n":"3Up start"},{"p":"12","s":"p4.start","n":"4Up start"}],[{"p":"13","s":"p3.up","n":"3Up up"},{"p":"14","s":"p4.up","n":"4Up up"}],[{"p":"15","s":"p3.down","n":"3Up down"},{"p":"16","s":"p4.down","n":"4Up down"}],[{"p":"17","s":"p3.left","n":"3Up left"},{"p":"18","s":"p4.left","n":"4Up left"}],[{"p":"19","s":"p3.right","n":"3Up right"},{"p":"20","s":"p4.right","n":"4Up right"}],[{"p":"21","s":"p3.b1"