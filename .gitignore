# Local ingest cache: source PDFs, rendered page images, OCR text.
cache/
node_modules/
.wrangler/

# Upstream corpus dump and everything derived from it. All regenerable:
#   curl -s -o data/machines.raw.json https://arcadertfm.com/machines.json
#   python3 tools/build_index.py && python3 tools/build_search.py
# The postings shards in particular are OCR'd text from third-party scans and
# grow to tens of MB — they belong in KV, not in git.
data/machines.raw.json
data/machine/
data/index/
data/ingest-state.json

# KiCad build outputs (the copies the site serves live under web/boards/).
kicad/*/export/
kicad/*/*-backups/
*.kicad_prl

# Traced vector derivatives of third-party scans — build artefacts, not source.
web/boards/*/vec/

# web/data/ IS tracked: it is the deployed corpus. Rebuild it from the
# pipeline with tools/build_assets.py.
#
# web/pages/ IS tracked for the same reason. It holds the page scans the
# reader shows inline: every page of a schematic, drawing or wiring document,
# and the drawing pages a manual's outline names. It is a deliberate subset
# chosen by tools/build_drawings.py, not the whole 8.9 GB of page images, and
# it is rebuilt with `build_drawings.py --images`.

# Python
__pycache__/
*.pyc

# Local secrets for `wrangler dev` — the deployed Worker gets these from
# `wrangler secret put`. Never commit one.
.dev.vars
.dev.vars.*
