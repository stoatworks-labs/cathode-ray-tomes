# Barrier audio board (Vectorbeam 18-10781) -- netlist converted from MAME
#
# Cinematronics vector games carry a small audio board of their own, driven from the
# CPU board's output latch: the latch bits arrive here as ports (OUT_0 ... OUT_7, MAME's
# TTL_INPUT names), and the board's sound goes out to a final amplifier that MAME does
# not simulate and this file therefore does not contain.
#
# MAME's file says it is derived from the schematics in the Barrier manual, and the board
# uses that sheet's designators (U1-U9, R1-R38, C1-C22, CR1-CR6, Q1-Q7).
#
# Source: MAME mame0289 (commit f34f02505e32), src/mame/cinematronics/nl_barrier.cpp,
# NETLIST_START(barrier). Licence CC0-1.0 by the file's own header (line 1),
# copyright-holders Aaron Giles (line 2).
# https://raw.githubusercontent.com/mamedev/mame/mame0289/src/mame/cinematronics/nl_barrier.cpp
# Converted by tools/mame_netlist.py; checked by tools/build_board_nets.py.
#
# What the conversion means. MAME's netlists are written to be simulated, so this is a
# second reading of the sheet by someone else, not a read of it: designators and pin
# numbers are MAME's unless the notes say the sheet was read to correct them. Names on
# `label` lines are MAME's, which mostly follow the sheet's with Q for an overbar; `net`
# is used only for the supply rails. A `port` is a net that leaves what this file
# describes -- a signal from the CPU or the other board, a cabinet control, or a source
# MAME simulates with a stand-in rather than the circuit.
#
#   net NAME: PIN ...     a supply rail
#   label NAME: PIN ...   a net MAME names
#   wire PIN PIN ...      an unnamed connection
#   port NAME: PIN ...    a net that leaves this file (see above)
#   nc PIN ...            a pin with nothing attached
#   parallel PIN ...      outputs the board sums on one node by design
#   value REF VALUE       a passive's value, in the unit MAME's own macro uses
#
# PIN is DESIGNATOR.NUMBER. Diode pin 1 is the cathode; transistors keep B, C and E;
# MAME does not record which way round an electrolytic goes, so C pins are MAME's 1/2.
#
# ---------------------------------------------------------------------------
# Undone: what MAME does to simulate the board that the board does not do
# ---------------------------------------------------------------------------
# line 30: #define HLE_NOISE_GEN 1 -> 0 (high-level stand-in for a real circuit)
# line 31: #define ENABLE_FRONTIERS 1 -> 0 (solver partitioning only)
# line 272: dropped NET_C(R19.2, GND) -- the sheet takes R19 on to C12 and the volume pot R29, in the final amplifier MAME does not simulate; MAME grounds it instead
# line 279: NET_C(GND, U2.3, U2.5, U2.11) -> nc -- tied to GND in MAME's "Unconnected inputs" block
# line 280: NET_C(GND, U5.1, U5.2, U5.5, U2.1) -> nc -- tied to GND in MAME's "Unconnected inputs" block
# Stand-ins that are not parts (the nets they drive are ports): TTL_INPUT(I_OUT_0), TTL_INPUT(I_OUT_1), TTL_INPUT(I_OUT_2)
#
# Left out by MAME (commented out at TAG, so not in this file either):
#   line 77: POT(R20, RES_K(10))     -- part of final amp (not emulated)
#   line 78: RES(R21, 150)           -- part of final amp (not emulated), not present on Space Wars
#   line 79: RES(R22, 2.7)           -- part of final amp (not emulated), not present on Space Wars
#   line 80: RES(R23, 2.7)           -- part of final amp (not emulated), not present on Space Wars
#   line 85: RES(R28, RES_K(150))    -- part of final amp (not emulated), illegible on Space Wars
#   line 86: POT(R29, RES_K(10))     -- part of final amp (not emulated)
#   line 87: RES(R30, 470)           -- part of final amp (not emulated)
#   line 102: CAP(C6, CAP_U(4.7))     // not needed
#   line 108: CAP(C12, CAP_U(0.01))   -- part of final amp (not emulated)
#   line 109: CAP(C13, CAP_P(470))    -- part of final amp (not emulated)
#   line 110: CAP(C14, CAP_P(470))    -- part of final amp (not emulated)
#   line 111: CAP(C15, CAP_U(50))     -- not needed
#   line 112: CAP(C16, CAP_U(2.2))    -- not needed
#   line 115: CAP(C19, CAP_U(50))     -- not needed
#   line 116: CAP(C20, CAP_U(2.2))    -- not needed
#   line 132: Q_2N6292(Q4)    // NPN -- not used
#   line 133: Q_2N6107(Q5)    // PNP -- not used
#   line 149: TTL_7815_DIP(U4)        // +15V Regulator -- not needed
#   line 157: TL081_DIP(U6)           // Op. Amp. -- part of final amp (not emulated)
#   line 161: TTL_7915_DIP(U7)        // -15V Regulator -- not needed
#
# Compared with the sheet (doc 458c844b4ab1 p23, 600 dpi), 2026-10-19: the noise source
# (CR1, CR2, Q1, Q2 -- Q2's base is left open on the sheet too), U1 and U3, the triangle
# and diamond envelopes (U2, Q3, Q6, R6-R13, R25-R27, CR3-CR6), U8 and the TL182 switch
# U5, and U9 with R31-R37 all agree with the sheet part for part, pin for pin and value
# for value, diode and transistor orientation included. Two differences, both MAME's
# deliberate:
#
# * Open question. The sheet draws U8 pin 6 straight onto the summing line (R13, R15, R37
#   and the jumper to C11): a T-junction on the U8.6/R38 line below R38, no dot. MAME leaves
#   it out (its line 239, commented) because the op-amp output would then hold the summing
#   node and swamp every other sound; the file's header calls it a suspected typo. This file
#   follows MAME. Not checked against a board.
# * The sheet's JUMPER between the summing line and C11 is not in MAME, which treats it as
#   closed (R17 sits on the jumper's C11 side on the sheet, on the summing line in MAME --
#   the same net while the jumper is in). R19 goes to C12 and the volume pot R29 on the
#   sheet, which are part of the final amplifier; MAME grounds it (line 272).

# part U1 TL081
# part U2 7406
# part U3 TL081
# part U5 TL182
# part U8 TL081
# part U9 TL081

value R1 18K
value R2 470
value R3 47K
value R4 220K
value R5 470
value R6 150
value R7 180K
value R8 10M
value R9 39K
value R10 2.2K
value R11 470
value R12 30K
value R13 8.2K
value R14 33K
value R15 15K
value R16 10M
value R17 10K
value R18 47K
value R19 820
value R24 47K
value R25 150
value R26 160K
value R27 750
value R31 470
value R32 1K
value R33 39K
value R34 6.8K
value R35 560K
value R36 1M
value R37 10K
value R38 10K
value C1 1uF
value C2 1uF
value C3 0.01uF
value C4 0.01uF
value C5 0.1uF
value C7 0.01uF
value C8 1uF
value C9 0.1uF
value C10 220pF
value C11 0.1uF
value C17 0.01uF
value C18 15uF
value C21 0.02uF
value C22 0.1uF
value CR1 1N914
value CR2 1N914
value CR3 1N914
value CR4 1N914
value CR5 1N914
value CR6 1N914
value Q1 2N3906
value Q2 2N3904
value Q3 2N6426
value Q6 2N6426
value Q7 2N3904

# ---------------------------------------------------------------------------
# Supplies
# ---------------------------------------------------------------------------
net GND: C18.2 C2.2 C21.1 C5.1 C9.1 CR4.1 CR6.1 Q2.C Q7.C R1.1 R10.1 R17.1 R18.1 R3.1 R34.1 R5.1 U2.7 U3.3 U5.8 U8.3 U9.3
net +15V: CR1.2 R2.2 U1.7 U3.7 U5.6 U8.7 U9.7
net +5V: C17.2 Q3.C Q6.C R26.2 R7.2 U2.14 U5.7
net -15V: U1.4 U3.4 U5.9 U8.4 U9.4

# ---------------------------------------------------------------------------
# Top-left until output from U1
# ---------------------------------------------------------------------------
wire CR1.1 CR2.2
wire CR2.1 Q1.B R1.2
wire Q1.E R2.1
wire C1.1 Q1.C Q2.E
wire C1.2 R3.2 U1.3
wire R4.1 R5.2 U1.2
wire C3.1 C8.2 R4.2 U1.6

# ---------------------------------------------------------------------------
# Top-middle, from O1 until output from CR3
# ---------------------------------------------------------------------------
port OUT_1: U2.13  # in MAME: TTL_INPUT(I_OUT_1)
wire R6.1 U2.12
wire C2.1 Q3.B R6.2 R7.1
wire Q3.E R11.2
wire CR3.2 R11.1

# ---------------------------------------------------------------------------
# Middle chunk, from C3 until output from R13
# ---------------------------------------------------------------------------
wire C3.2 R8.1 U3.2
wire R8.2 R9.1 U3.6
wire C4.1 CR3.1 CR4.2 R10.2 R9.2
wire C4.2 R12.1
wire C5.2 R12.2 R13.1

# ---------------------------------------------------------------------------
# Big middle section, from C8 until output from R15/R41/R37
# ---------------------------------------------------------------------------
wire C8.1 R24.1
wire C10.1 R16.1 R24.2 U8.2
wire C10.2 R16.2 R31.1 R38.1 U8.6
wire R38.2 U5.14
port OUT_2: U5.10  # in MAME: TTL_INPUT(I_OUT_2)
wire C7.1 U5.13
wire C7.2 R14.1
wire C11.1 R13.2 R15.2 R17.2 R37.2
wire C9.2 R14.2 R15.1
port OUT_0: U2.9  # in MAME: TTL_INPUT(I_OUT_0)
wire R25.1 U2.8
wire C17.1 C18.1 Q6.B R25.2 R26.1
wire Q6.E R27.2
wire CR5.2 R27.1
wire C21.2 C22.1 CR5.1 CR6.2 R33.2 R34.2
wire Q7.E R31.2 R32.2 R33.1
wire Q7.B R32.1
wire C22.2 R35.1
wire R35.2 R36.1 U9.2
wire R36.2 R37.1 U9.6

# ---------------------------------------------------------------------------
# Final stage
# ---------------------------------------------------------------------------
port OUTPUT: C11.2 R18.2 R19.1  # on the sheet, U6 pin 3: the final amplifier, which MAME does not simulate
port R19_TO_C12: R19.2  # the sheet takes R19 on to C12 and the volume pot R29, in the final amplifier MAME does not simulate; MAME grounds it instead

# ---------------------------------------------------------------------------
# Pins with nothing attached
# ---------------------------------------------------------------------------
nc U2.3 U2.5 U2.11  # line 279: tied to GND in MAME's "Unconnected inputs" block
nc U5.1 U5.2 U5.5 U2.1  # line 280: tied to GND in MAME's "Unconnected inputs" block
# Pins the MAME netlist never mentions. On a real board these are unused outputs, or
# inputs left open or tied in a way MAME did not draw; they are written here so that
# the checker's coverage test still means something for every other pin.
nc U1.1 U1.5 U1.8  # NULL NULL NC
nc U2.2 U2.4 U2.6 U2.10  # open collector open collector open collector open collector
nc U3.1 U3.5 U3.8  # NULL NULL NC
nc U5.3 U5.4 U5.11 U5.12  # NC NC NC NC
nc U8.1 U8.5 U8.8  # NULL NULL NC
nc U9.1 U9.5 U9.8  # NULL NULL NC
